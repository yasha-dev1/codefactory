# Gateway API
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8585
GATEWAY_DEBUG=false
GATEWAY_CORS_ORIGINS=["http://localhost:5173"]
GATEWAY_GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
GATEWAY_REGISTRATION_SECRET=your-registration-secret-here
GATEWAY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gateway
GATEWAY_REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
